# FastAPI base URL for direct browser calls. Empty (default) = same-origin
# "/api" via the Vite dev proxy (or the production static host proxy).
# Only set this when the API is served from another origin.
VITE_API_BASE=

# DEV ONLY (ADR-0006 dev_test identity): bearer token = test user UUID
# listed in backend DEV_TEST_USER_IDS, with backend AUTH_MODE=dev_test.
# Hard-disabled in production. Never set a real credential here.
VITE_DEV_USER_TOKEN=

# Canonical site origin, baked into SSG canonical/meta tags at build time.
VITE_SITE_URL=https://jlptgo.example.com
